# ============================================================
# Autonomous Faceless AI Media Channel — Environment Template
# ============================================================
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# ─── Application ────────────────────────────────────────────
APP_ENV=development               # development | production
APP_SECRET_KEY=change-me-to-a-random-string-32-chars-min
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/faceless.db

# ─── Google / Gemini AI ─────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── YouTube Data API v3 ────────────────────────────────────
# 1. Create project at console.cloud.google.com
# 2. Enable YouTube Data API v3
# 3. Create OAuth 2.0 Client ID (Desktop app type)
# 4. Download client_secret.json to ./credentials/
YOUTUBE_CLIENT_SECRET_FILE=./credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./credentials/youtube_token.json
# Default privacy for uploads: private | unlisted | public
YOUTUBE_DEFAULT_PRIVACY=private
# Set to true to enable actual uploads
YOUTUBE_PRODUCTION_MODE=false

# ─── Instagram / Meta Graph API ─────────────────────────────
# 1. Create Facebook App at developers.facebook.com
# 2. Add Instagram Graph API product
# 3. Connect your Instagram Professional account
# 4. Generate long-lived access token
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Public URL base where the app can serve rendered videos for Meta to fetch
# e.g. https://your-server.com  (must be publicly reachable by Meta)
INSTAGRAM_MEDIA_BASE_URL=
# Set to true to enable actual publishing
INSTAGRAM_PRODUCTION_MODE=false

# ─── Pexels API ─────────────────────────────────────────────
# Free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# ─── Pixabay API ────────────────────────────────────────────
# Free key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ─── Reddit API (optional — for Pillar D storytelling) ──────
# App at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=faceless-ai-channel/1.0

# ─── Content Strategy ───────────────────────────────────────
# Pillar distribution (must sum to 100)
PILLAR_PSYCHOLOGY_PCT=30
PILLAR_HISTORY_PCT=25
PILLAR_TECHNOLOGY_PCT=25
PILLAR_STORYTELLING_PCT=20

# ─── Scheduler ──────────────────────────────────────────────
# Daily pipeline trigger time (24h format, local server time)
DAILY_PIPELINE_TIME=09:00
TIMEZONE=Asia/Kolkata

# ─── Video Settings ─────────────────────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_MIN_DURATION=15
VIDEO_MAX_DURATION=30
VIDEO_BITRATE=4000k
AUDIO_BITRATE=192k

# ─── Voice / TTS ────────────────────────────────────────────
# Primary TTS provider: piper | edge | none
TTS_PRIMARY_PROVIDER=edge
# Edge TTS voice name
EDGE_TTS_VOICE=en-US-AriaNeural
# Piper TTS model path (download separately)
PIPER_MODEL_PATH=./assets/tts_models/en_US-lessac-medium.onnx

# ─── Brand ──────────────────────────────────────────────────
CHANNEL_NAME=MindBlown Facts
BRAND_COLOR=#6C63FF
CAPTION_FONT=Montserrat-Bold
CAPTION_SIZE=52
WATERMARK_ENABLED=false

# ─── Notifications (optional) ────────────────────────────────
# Simple webhook for operator alerts (e.g. Discord, Slack)
NOTIFICATION_WEBHOOK_URL=

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
