<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- Unique label — must match filename -->
  <key>Label</key>
  <string>com.faceless.daily-pipeline</string>

  <!-- Command to run -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/bawa/Desktop/Projects/faceless-ai-channel/.venv/bin/python</string>
    <string>/Users/bawa/Desktop/Projects/faceless-ai-channel/scripts/run_daily.py</string>
  </array>

  <!-- Working directory -->
  <key>WorkingDirectory</key>
  <string>/Users/bawa/Desktop/Projects/faceless-ai-channel</string>

  <!-- launchd's default PATH omits Homebrew, where ffmpeg/ffprobe live -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Daily at 6:30 PM IST, with automatic retry slots at 8:00 and 9:30 PM.
       run_daily.py exits immediately if today's video is already uploaded,
       and resumes today's job if an earlier slot failed.
       Keep in sync with RUN_SLOTS in scripts/run_daily.py. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>18</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>21</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>

  <!-- Log stdout/stderr -->
  <key>StandardOutPath</key>
  <string>/Users/bawa/Desktop/Projects/faceless-ai-channel/logs/launchd_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bawa/Desktop/Projects/faceless-ai-channel/logs/launchd_stderr.log</string>

  <!-- Restart on crash -->
  <key>KeepAlive</key>
  <false/>

  <!-- Run even if Mac was asleep at trigger time -->
  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
